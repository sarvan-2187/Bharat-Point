# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

NODE_ENV=development

# ── Backend ───────────────────────────────────────────────────────────
PORT=4000
# 127.0.0.1 = this laptop only. For a phone demo on the LAN set HOST=0.0.0.0
# (phones must reach the API) and allow port 4000 through Windows Firewall on
# private networks only. Once Caddy fronts the API, go back to 127.0.0.1
# (audit F-10).
HOST=127.0.0.1

# ── Postgres (docker-compose reads POSTGRES_PASSWORD from this file) ──
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
# Same password as above.
DATABASE_URL=postgresql://bharatpoint:CHANGE_ME@127.0.0.1:5432/bharatpoint

# ── Authorization chain ───────────────────────────────────────────────
# Root secret for the chain and settlement-capability MACs (32+ characters).
# Keep it stable: changing it makes every existing chain fail verification.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ATTESTATION_SECRET=

# ── Mock bank (demo provider, services/mock-bank) ─────────────────────
# Shared secret the backend sends to the mock bank (16+ characters).
# Generate the same way as above. Both services read it from this file.
MOCK_BANK_TOKEN=
MOCK_BANK_URL=http://127.0.0.1:4100
# A bank answer slower than this is treated as UNKNOWN (never as failed).
PROVIDER_TIMEOUT_MS=5000

# ── Customer confirmation call (IVR on the Mac) ───────────────────────
# Leave IVR_URL empty to disable calls: confirmation then fails closed and
# nothing can reach the bank. The secret (32+ chars) must match the IVR's.
IVR_URL=
IVR_SHARED_SECRET=
CONFIRMATION_TTL_SECONDS=180

# ── Fraud review (advisory; see docs/FRAUD_MODEL.md) ──────────────────
# Leave FRAUD_SCORER_URL empty to switch scoring off: every payment then shows
# "assessment unavailable" to the admin (never "low risk"). Start the scorer with
# services/fraud-scorer (python fetch_model.py, then python server.py).
FRAUD_SCORER_URL=
# 16+ characters; the scorer reads the same value as FRAUD_SCORER_TOKEN.
FRAUD_SCORER_TOKEN=
FRAUD_SCORER_TIMEOUT_MS=3000
# Probability at or above which a payment is MEDIUM / HIGH risk. The model's
# author published no threshold: these two are this project's starting points,
# to be tuned by whoever owns the risk. Must satisfy 0 < MEDIUM < HIGH <= 1;
# an invalid value stops the server at start-up.
FRAUD_THRESHOLD_MEDIUM=0.50
FRAUD_THRESHOLD_HIGH=0.80
# gender / location encodings the model was trained with (default: backend/config/fraud-feature-map.json, ships empty)
# FRAUD_FEATURE_MAP=

# ── Demo switches ─────────────────────────────────────────────────────
# true enables the customer simulator, bank fault injection and seed data.
# Never true outside a demo.
DEMO_MODE=true
